#!/bin/sh
if grep -q '^error: compiling generated source$' "$2"; then
  if grep -Eq ": error: .*('macro_result'| 'struct macro_result').*incompatible.*'(int|int32_t)'|: error: .*'(int|int32_t)'.*incompatible.*'(struct )?macro_result'" "$2"; then
    printf '%s\n' "error: cannot use a 'macro_result' as an 'int'" > "$2"
  fi
else
  sed -n -E '
    s/^chpl_macro_call_[A-Za-z0-9_$]+_[0-9]+:[0-9]+:[0-9]+: (error: returning )'\''(struct )?macro_result'\''( \(aka '\''struct macro_result'\''\))? (from a function with incompatible result type '\''int'\'')$/\1'\''macro_result'\'' \4/p
    s/^(macro-record-result-wrong-type\.chpl):[0-9]+: (error: .*)$/\1: \2/p
  ' "$2" > "$2.tmp" && mv "$2.tmp" "$2"
fi
