#!/usr/bin/env bash

OUTPUT=$2
# Jade: With https://github.com/chapel-lang/chapel/pull/29645, I don't think we
# really need this anymore. but keeping for now to avoid noise since we really
# don't care about output after the last print

# any output that occurs after the last print from the program is not relevant
# whats important is that the debugger output matches, what happens after `quit`
# can be unpredictable and is not relevant
sed -n '1,/New array on locale/p' "$OUTPUT" > "$OUTPUT.tmp"
mv "$OUTPUT.tmp" "$OUTPUT"
