#!/usr/bin/env python3

import sys, re, subprocess, os

testname = sys.argv[1]
outfile =  sys.argv[2]

f = open(outfile)
lines = f.readlines()
f.close()

f = open(outfile, 'w')
for l in lines:
    s = re.sub(r'(?<=index not in domain: )\d+', '0', l)
    f.write(s)

f.close()

env = os.environ.copy()
env["EXPECTED_MSG"]='1 + 9223372036854775807 cannot be represented'
prediff_script = os.path.join(env["CHPL_HOME"], "util", "test", "prediff-for-ok-param-overflow")
subprocess.run([prediff_script] + sys.argv[1:], env=env)
