#!/usr/bin/env python3

import os, subprocess as sp, sys, re

target = sys.argv[1]
output_file = sys.argv[2]

chpl_home = os.environ["CHPL_HOME"]

# This will be generated by a '.precomp' script.
legacy_header_path = os.getcwd() + "/legacy-chpl-env-gen.h"

runtime_build_path = (
    sp.check_output(
        [
            chpl_home + "/util/printchplenv",
            "--runtime",
            "--path",
        ]
    )
    .decode()
    .rstrip("\n")
)

header_path = chpl_home + "/build/runtime/" + runtime_build_path + \
              "/include/chpl-env-gen.h"

with open(header_path, "r") as fp:
  header = fp.read()

with open(legacy_header_path, "r") as fp:
  legacy_header = fp.read()

pattern = re.compile(r"^\s*#\s*define\s+[A-Za-z_]\w*\s*$", re.MULTILINE)
matches = pattern.findall(legacy_header)

with open(output_file, "w+") as fp:
  for match in matches:
    if not match in header:
      fp.write(f"Failed to find: {match}\n")
