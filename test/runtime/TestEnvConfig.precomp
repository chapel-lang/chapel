#!/usr/bin/env bash

chpl=$3
chpl_home=$($chpl --print-chpl-home)
env_header_template=$chpl_home/runtime/etc/chpl-env-gen-template.h
out_header=legacy-chpl-env-gen.h

echo "Legacy generation of $out_header"
cp $env_header_template $out_header
echo "/* THIS FILE IS AUTOMATICALLY GENERATED */" >> $out_header
echo "#ifndef _CHPL_ENV_GEN_H_" >> $out_header
echo "#define _CHPL_ENV_GEN_H_" >> $out_header
$chpl_home/util/printchplenv --runtime --no-tidy --anonymize --simple | \
  sed 's/^ *//;s/ *$$//' | \
  sed 's/[^0-9A-Za-z]/_/g' | \
  awk '{ print "#define " toupper($$1) }' >> $out_header
echo "#endif /* _CHPL_ENV_GEN_H_ */" >> $out_header
