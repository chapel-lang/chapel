#!/usr/bin/env python3

import os
import sys
import time

def main(argv):
    if os.getenv("CHPL_TEST_SINFO_LARGE_OUTPUT"):
        print("256 2")
        sys.stdout.flush()
        time.sleep(0.1)
        sys.stderr.write("x" * 2048)
        sys.stderr.flush()
        return

    partition = None
    for arg in argv:
        if arg.startswith("--partition"):
            (_,partition) = arg.split('=')

    if (partition == "foo"):
        print("64 1 res_foo")
        print("128 2")
    elif (partition == "bar"):
        print("48 1 res_bar")
        print("96 2")
    else:
        print("256 2")

if __name__ == '__main__':
    main(sys.argv)
