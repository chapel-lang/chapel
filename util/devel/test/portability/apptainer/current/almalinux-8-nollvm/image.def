BootStrap: docker
From: almalinux:8

%files
    ../../provision-scripts/* /provision-scripts/

%post
    /provision-scripts/dnf-upgrade.sh
    /provision-scripts/dnf-epel.sh
    /provision-scripts/dnf-deps-gcc-toolset-10.sh

%environment
    source /opt/rh/gcc-toolset-10/enable #unsudo

%runscript
    ../../provision-scripts/run.sh "$@"
