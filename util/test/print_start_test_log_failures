#!/usr/bin/env python3

"""Print the full start_test log output of each failed test."""

import argparse
import sys
from convert_start_test_log_to_junit_xml import _parse_start_test_log


def is_failure(test_case):
    # the jUnit parser also reports warnings as errors, only keep real failures
    error = test_case["error"]
    return error is not None and error["message"].lower().startswith("error")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("start_test_log", help="start_test log file to read")
    parser.add_argument(
        "--ga-groups",
        action="store_true",
        help="wrap each failed test in a GitHub Actions log group",
    )
    args = parser.parse_args()

    for test_case in _parse_start_test_log(args.start_test_log):
        if not is_failure(test_case):
            continue
        title = "{0}/{1}: {2}".format(
            test_case["classname"],
            test_case["name"],
            test_case["error"]["message"],
        )
        if args.ga_groups:
            print("::group::" + title)
        else:
            print("=== " + title + " ===")
        sys.stdout.write(test_case["system-out"])
        if args.ga_groups:
            print("::endgroup::")


if __name__ == "__main__":
    main()
