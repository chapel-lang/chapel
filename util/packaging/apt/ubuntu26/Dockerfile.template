@@{FROM}

@@{ARGUMENTS}
ARG DEBIAN_FRONTEND=noninteractive
@@{INJECT_BEFORE_DEPS}

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y \
      curl wget vim sudo gcc g++ m4 perl chrpath \
      python3 python3-dev python3-venv bash make mawk git pkg-config cmake \
      llvm-22-dev llvm-22 clang-22 libclang-22-dev libclang-cpp22-dev libedit-dev \
      libpmi2-0-dev libslurm-dev \
      pkgconf libgmp-dev libhwloc-dev \
      libunwind-dev \
      cuda-minimal-build-13-1 libcurand-dev-13-1

@@{USER_CREATION}

@@{GET_CHAPEL}

@@{BUILD_DEFAULT}

@@{INSTALL}

@@{PACKAGE_SETUP}

@@{PACKAGE_BUILD}

