    "ibv-conduit/Makefile") CONFIG_FILES="$CONFIG_FILES ibv-conduit/Makefile" ;;
    "ibv-conduit/conduit.mak") CONFIG_FILES="$CONFIG_FILES ibv-conduit/conduit.mak" ;;
