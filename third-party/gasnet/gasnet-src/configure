$as_echo "$gasnet_cv_have_sparc32_64bit_asm" >&6; }
if test "$gasnet_cv_have_sparc32_64bit_asm" = yes; then
  :
  $as_echo "#define GASNETI_HAVE_SPARC32_64BIT_ASM 1" >>confdefs.h

